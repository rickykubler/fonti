# Copy to .env (ignored by git) only if you opt in to a remote, OpenAI-compatible LLM.
# Remote endpoints also need llm.allow_remote = true: questions and passages leave your computer.
# FONTI_LLM__PROVIDER=openai
# FONTI_LLM__BASE_URL=https://api.example.com/v1
# FONTI_LLM__MODEL=model-name
# FONTI_LLM__ALLOW_REMOTE=true
# FONTI_LLM__API_KEY=
